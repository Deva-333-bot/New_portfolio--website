# Server & Environment Configuration
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
CANONICAL_SITE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# Database Configuration (PostgreSQL for production; SQLite default for local testing)
DATABASE_URL=sqlite:///./portfolio.db
# DATABASE_URL=postgresql+psycopg2://portfolio_user:secure_password@localhost:5432/portfolio_db

# Security & Sessions (Generate with: openssl rand -hex 32)
SESSION_SECRET=change_me_to_a_very_secure_random_64_character_hex_string_for_production
PASSWORD_RESET_SECRET=change_me_to_another_secure_random_64_character_hex_string
SESSION_EXPIRE_HOURS=24

# Allowed CORS Origins (Comma-separated)
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Bootstrap Initial Administrator Credentials (Used by python -m app.cli.bootstrap_admin)
ADMIN_BOOTSTRAP_EMAIL=admin@florante.tech
ADMIN_BOOTSTRAP_PASSWORD=REPLACE_WITH_A_UNIQUE_DEVELOPMENT_PASSWORD

# Email Delivery Configuration (Optional / Transactional Provider: resend, sendgrid, smtp, or console)
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=hello@florante.tech
EMAIL_PROVIDER_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# GitHub API Integration (Optional personal access token for higher rate limits)
GITHUB_TOKEN=
GITHUB_USERNAME=

# Storage & Media Configuration
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./uploads
MAX_UPLOAD_SIZE_BYTES=10485760

# Rate Limiting
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_CONTACT_PER_MINUTE=5
RATE_LIMIT_ANALYTICS_PER_MINUTE=60
